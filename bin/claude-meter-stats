#!/usr/bin/env bash
# Compatibility shim. The collector is bin/usage-meter-stats since the app was
# renamed to Usage Meter on 2026-09-21; this name stays for ONE release because
# a config-management run pins a commit and deploys a path, so the old path has
# to keep working through the release that moves it.
#
# It execs rather than sources, so the real script's own argv, exit status and
# signal handling are untouched, and it resolves the sibling through its own
# real path so a symlinked deployment (which is how this is usually installed)
# finds it.
exec "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/usage-meter-stats" "$@"
