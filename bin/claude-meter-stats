#!/usr/bin/env bash
# Emit ONE JSON blob for the "Claude Meter" menu-bar app: the Claude account's
# real rate-limit utilisation, plus a section per OTHER agentic CLI installed on
# this Mac that can report its own quota locally.
#
# PRESENCE-GATED, ALWAYS. A tool that is not installed contributes no key at
# all, so the blob -- and therefore the menu -- is byte-identical to what it was
# before that tool was supported. Nothing prints an empty row or an error for a
# binary nobody has.
#
# THE NUMBERS ARE REAL, NOT DERIVED. Claude Code caches the account's actual
# rate-limit utilisation -- what `/usage` shows -- in `cachedUsageUtilization`
# in its config file, and the same numbers are served live by the OAuth usage
# endpoint. Three limits live in `utilization.limits[]`, each with a `percent`,
# a `resets_at` and a `severity`:
#   kind=session        the 5-hour window
#   kind=weekly_all     the weekly limit across all models
#   kind=weekly_scoped  the weekly limit for premium models
# Token counts without a denominator are noise, which is what this replaced.
#
# SEVERAL IDENTITIES. One Mac can hold more than one Claude Code identity, each
# in its own config directory (the default ~/.claude, plus anything pointed at
# by CLAUDE_CONFIG_DIR), and each caches its OWN account's utilisation. All of
# them are read, and ONE is shown: the identity with the newest LIVE session
# (Claude Code's registry <config dir>/sessions/<pid>.json, `updatedAt`, pid
# still alive), the freshest cachedUsageUtilization breaking a tie. An identity
# WITHOUT that cache is still a candidate: right after a /login the new account
# has none, and skipping it made the meter wear the other identity's stale
# account for hours (fixed 2026-09-09). The live API answer is cached per
# identity AND per email, so a switched account never shows the previous one's
# numbers. The age of whatever is shown is reported -- a number nobody has
# refreshed is never presented as current.
#
# FAST AND SILENT: a couple of JSON reads plus, at most once per TTL, one
# bounded HTTPS call. No tokens are ever printed, logged or put in argv.
#
# Environment:
#   CLAUDE_METER_CONFIG_DIRS  colon-separated list of config dirs to consider,
#                             replacing the default discovery entirely. An entry
#                             may be "label=path" to name the identity:
#                             "work=$HOME/.claude:personal=$HOME/.claude-personal".
#                             A bare path keeps the directory-derived name.
#                             Give a config dir the SAME absolute path, with no
#                             trailing slash, that CLAUDE_CONFIG_DIR was given:
#                             the keychain service is derived from that string,
#                             so a different spelling of the same directory
#                             finds no token.
#   CLAUDE_CONFIG_DIR         Claude Code's own variable; added to the defaults
#   CLAUDE_METER_CACHE_DIR    where the API cache, backoff stamp and usage
#                             history live (default ~/.cache/claude-meter)
#   USAGE_API_TTL             seconds; overrides the adaptive 120s/900s TTL
#   CODEX_HOME                codex's own variable; where its state lives
#                             (default ~/.codex). Read for PRESENCE and for the
#                             existence of auth.json -- never for its contents.
#   CLAUDE_METER_CODEX        "0" turns the codex section off entirely
#   CODEX_USAGE_TTL           seconds; overrides the adaptive 120s/900s TTL

set -uo pipefail

# A launchd-spawned shell inherits a sparse PATH, and this script needs
# python3, security and curl from /usr/bin. Append rather than prepend, so an
# operator's own PATH still wins.
case ":$PATH:" in
  *:/usr/bin:*) ;;
  *) PATH="$PATH:/usr/bin:/bin:/usr/sbin:/sbin" ;;
esac
export PATH

# The heredoc is deliberately NOT inside $(...): the menu-bar app runs this
# script with /bin/bash (3.2), whose parser token-scans a heredoc inside command
# substitution and pairs single quotes naively -- one apostrophe in a Python
# comment then reads as an unterminated string and the whole script dies at EOF.
# A plain heredoc redirected to a temp file parses correctly, and frees every
# future edit from balancing apostrophes.
py_out="$(mktemp)"
python3 - <<'PY' >"$py_out" 2>/dev/null
import json, pathlib, datetime, hashlib, math, os, queue, shutil, subprocess, threading, time
from collections import namedtuple

HOME = pathlib.Path.home()
DEFAULT_CONFIG_DIR = HOME / ".claude"

CACHE_DIR = pathlib.Path(os.environ.get("CLAUDE_METER_CACHE_DIR") or (HOME / ".cache" / "claude-meter"))
API_CACHE = CACHE_DIR / "usage-api.json"
BACKOFF = CACHE_DIR / "usage-api.backoff"
HISTORY = CACHE_DIR / "usage-history.csv"

# The three limits the app draws, keyed by the endpoint's own `kind`.
LIMIT_KEYS = {"session": "session", "weekly_all": "weekly", "weekly_scoped": "scoped"}

# Roll a PAST resets_at forward ONLY for the weekly limits: their reset is a
# fixed schedule, so adding whole weeks states a fact. The session window is
# NOT on a grid -- a new 5 h window anchors on first use after idle -- so rolling
# it forward fabricated countdowns ("resets in 1h57" for a window that ended
# hours ago). A past session reset now reports 0 and the app shows a dash.
RESET_CADENCE = {"weekly_all": 7 * 86400, "weekly_scoped": 7 * 86400}

# Why the live path is not serving, in words the dropdown can print.
FETCH_ERROR_TEXT = {"429": "rate-limited", "token": "no valid token",
                    "shape": "bad response", "net": "network error"}

# What the scoped weekly cap applies to when the response names nothing --
# better a generic word than a model family this script invented.
DEFAULT_SCOPED_LABEL = "Model"

# A history point is recorded only when a value CHANGES or this long has passed:
# the session cache is flat between claude runs, so a 30 s poll would otherwise
# write ~2880 identical rows a day for no information. The cap keeps the file to
# a few tens of KB.
HISTORY_MIN_INTERVAL = 600
HISTORY_MAX_ROWS = 2000


def load_json(path):
    try:
        return json.loads(pathlib.Path(path).read_text())
    except Exception:
        return None


# ── Identities ──────────────────────────────────────────────────────────────

Identity = namedtuple("Identity", "config_dir label email cached_utilization cached_at")


def parse_config_dirs_entry(spec):
    """One CLAUDE_METER_CONFIG_DIRS entry: "path", or "label=path" to name the
    identity yourself instead of taking the name from the directory.

    The label form is recognised only when the part before the first "=" is a
    bare name -- no "/" in it -- so a directory whose own name contains an "="
    is still read as a path. Returns (path, label or None)."""
    head, sep, tail = spec.partition("=")
    if sep and head.strip() and "/" not in head and tail.strip():
        return pathlib.Path(os.path.expanduser(tail.strip())), head.strip()
    return pathlib.Path(os.path.expanduser(spec.strip())), None


def config_dirs():
    """Every Claude Code identity to consider, as (path, label or None), in
    discovery order.

    CLAUDE_METER_CONFIG_DIRS replaces the list outright, and its entries may
    carry labels ("work=~/.claude:personal=~/.claude-personal"). Otherwise:
    whatever CLAUDE_CONFIG_DIR names, the default ~/.claude, and any
    ~/.claude-<name> directory that actually holds a config file (that is how a
    second identity is kept on one Mac -- CLAUDE_CONFIG_DIR pointed at it in the
    shell that launches it)."""
    seen, out = set(), []

    def add(path, label=None):
        if str(path) not in seen:
            seen.add(str(path))
            out.append((path, label))

    override = os.environ.get("CLAUDE_METER_CONFIG_DIRS", "").strip()
    if override:
        for spec in override.split(":"):
            if spec.strip():
                add(*parse_config_dirs_entry(spec))
        return out
    for spec in os.environ.get("CLAUDE_CONFIG_DIR", "").split(":"):
        if spec.strip():
            add(pathlib.Path(os.path.expanduser(spec.strip())))
    add(DEFAULT_CONFIG_DIR)
    try:
        for path in sorted(HOME.glob(".claude-*")):
            if path.is_dir() and (path / ".claude.json").exists():
                add(path)
    except Exception:
        pass
    return out


def label_for(config_dir, override=None):
    """A short name for the identity, shown beside the account email. An
    explicit label from CLAUDE_METER_CONFIG_DIRS wins: the name is what a
    person recognises the account by, and the directory it happens to live in
    need not say it."""
    if override:
        return override
    if config_dir == DEFAULT_CONFIG_DIR:
        return "default"
    name = config_dir.name.lstrip(".")
    if name.startswith("claude-"):
        name = name[len("claude-"):]
    return name or str(config_dir)


def config_file(config_dir):
    """Claude Code keeps the DEFAULT identity's config beside its state
    directory (~/.claude.json, not ~/.claude/.claude.json); a custom
    CLAUDE_CONFIG_DIR holds both. Prefer whichever actually exists."""
    candidates = [config_dir / ".claude.json"]
    if config_dir == DEFAULT_CONFIG_DIR:
        candidates.insert(0, HOME / ".claude.json")
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def newest_live_session(config_dir):
    """Newest updatedAt (seconds) among this identity's LIVE sessions, read from
    the registry Claude Code keeps in <config dir>/sessions/<pid>.json; 0 when
    the identity has no live session."""
    newest = 0.0
    try:
        for path in (config_dir / "sessions").glob("*.json"):
            try:
                session = json.loads(path.read_text())
                pid = int(session.get("pid") or 0)
                if pid <= 0:
                    continue
                os.kill(pid, 0)    # raises when the process is gone
                newest = max(newest, (session.get("updatedAt") or session.get("startedAt") or 0) / 1000)
            except Exception:
                continue
    except Exception:
        pass
    return newest


def pick_identity():
    """The one identity to show, or None when nothing is known about any of
    them: the newest live session wins, the freshest cachedUsageUtilization
    only breaks a tie."""
    best, best_rank = None, None
    for config_dir, label_override in config_dirs():
        config = load_json(config_file(config_dir))
        if not isinstance(config, dict):
            continue
        cached = config.get("cachedUsageUtilization")
        if not isinstance(cached, dict):
            cached = {}
        email = (config.get("oauthAccount") or {}).get("emailAddress") or ""
        if not cached and not email:
            continue      # nothing known about this identity
        rank = (newest_live_session(config_dir), (cached.get("fetchedAtMs") or 0) / 1000)
        if best_rank is None or rank > best_rank:
            best_rank = rank
            best = Identity(config_dir, label_for(config_dir, label_override), email,
                            cached.get("utilization") or {}, rank[1])
    return best


# ── The live usage endpoint ─────────────────────────────────────────────────
#
# `cachedUsageUtilization` is only rewritten while claude runs, so reading it
# alone left the menu bar as fresh as the last session (5 h stale, with an
# already-expired session window). /usage GETs this endpoint with the profile's
# OAuth token and the response carries the SAME limits[] shape, so this calls
# it too.
#
# THE ENDPOINT RATE-LIMITS. A 25 s TTL while claude ran is ~120 requests/hour
# against the app's 30 s poll: the endpoint answered 429 and STAYED 429 because
# every poll retried instantly, and the meter fell back to the file cache
# forever while looking live (2026-09-01: 30% shown from a 3 h-old cache while
# the last good API answer, 7 minutes earlier, said 46%). Limits move slowly, so
# one call per TTL -- ~30 requests/hour -- is plenty current and far below the
# threshold, and any failure parks the network path for a while afterwards.

API_URL = "https://api.anthropic.com/api/oauth/usage"
TTL_WHILE_CLAUDE_RUNS = 120
TTL_WHILE_IDLE = 900
BACKOFF_AFTER_429 = 900
BACKOFF_AFTER_OTHER = 180


def claude_is_running():
    try:
        found = subprocess.run(["pgrep", "-f", r"(^|/)claude($| )"],
                               capture_output=True, text=True, timeout=5)
        return found.returncode == 0 and bool(found.stdout.strip())
    except Exception:
        return False


API_TTL = int(os.environ.get("USAGE_API_TTL", "0")) or \
    (TTL_WHILE_CLAUDE_RUNS if claude_is_running() else TTL_WHILE_IDLE)
# Sampled here, after the running-session check above, as it always was: every
# time-derived field (age_s, reset_in, fetched_at, the history row) moves with it.
NOW = datetime.datetime.now(datetime.timezone.utc).timestamp()


def keychain_service(config_dir):
    # Claude Code keys its Keychain item to the config dir: the DEFAULT dir uses
    # the bare name, any other appends sha256(dir)[:8] (verified against a live
    # keychain). Deriving it beats a ~160 KB `security dump-keychain` per poll
    # and, more importantly, pins the fetch to THIS account's token -- trying
    # every token in turn meant one identity's failure could return ANOTHER
    # account's numbers under the first one's label.
    #
    # The hash is over the PATH STRING, so it is only ever as right as the
    # spelling it is given: pass the same absolute path Claude Code was given.
    # Nothing here resolves symlinks or rewrites the path to "fix" a mismatch --
    # a normalisation this script invented would just be a second spelling to
    # be wrong in, and it would fail silently as "no valid token".
    if config_dir == DEFAULT_CONFIG_DIR:
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(str(config_dir).encode()).hexdigest()[:8]


def access_token(service):
    try:
        raw = subprocess.run(["security", "find-generic-password", "-s", service, "-w"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
        oauth = json.loads(raw).get("claudeAiOauth", {})
        if oauth.get("accessToken") and oauth.get("expiresAt", 0) > time.time() * 1000:
            return oauth["accessToken"]
    except Exception:
        pass
    return None


def fetch_usage(config_dir):
    """One attempt with THIS identity's token only. Returns (data, errkind)."""
    token = access_token(keychain_service(config_dir))
    if not token:
        return None, "token"     # expired/absent: claude refreshes it, not us
    try:
        # The token reaches curl on STDIN (`--config -`), never argv and never a
        # file: argv is world-readable through `ps`, and a temporary file -- even
        # one created 0600 and unlinked in a finally -- still puts the token on
        # disk, where a crash between write and unlink leaves it. A pipe exists
        # only between these two processes and dies with them.
        config = ('header = "Authorization: Bearer %s"\n'
                  'header = "anthropic-beta: oauth-2025-04-20"\n'
                  'header = "Content-Type: application/json"\n' % token)
        answer = subprocess.run(["curl", "-sS", "--max-time", "15",
                                 "-w", "\n%{http_code}", "--config", "-", API_URL],
                                input=config, capture_output=True, text=True, timeout=20)
        body, _, code = answer.stdout.rpartition("\n")
        if code.strip() == "429":
            return None, "429"
        data = json.loads(body)
        if isinstance(data, dict) and data.get("limits"):
            return data, None
        return None, "shape"
    except Exception:
        return None, "net"


def backoff_state():
    """(active, why, retry_in_s) from the stamp. The WHY is kept so a poll
    during backoff can still tell the UI what actually failed -- a silent
    fallback to the session cache is indistinguishable from freshness, which
    is exactly the lie this meter exists not to tell."""
    try:
        parts = BACKOFF.read_text().split()
        stamped_at, wait = float(parts[0]), float(parts[1])
        why = parts[2] if len(parts) > 2 else "error"
        left = stamped_at + wait - time.time()
        return left > 0, why, max(0, int(left))
    except Exception:
        return False, "", 0


def start_backoff(seconds, why):
    try:
        BACKOFF.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        BACKOFF.write_text("%d %d %s" % (time.time(), seconds, why))
    except Exception:
        pass


def load_api_cache(identity):
    # The cache records WHICH account it holds -- the identity label AND the
    # email: on a machine where the shown identity flips, or where /login moved
    # an identity to another account, a cached answer for a different account
    # must read as "no cache", not as data.
    cached = load_json(API_CACHE)
    if isinstance(cached, dict) and cached.get("account") == identity.label \
            and cached.get("email", "") == identity.email \
            and isinstance(cached.get("data"), dict):
        return cached["data"], float(cached.get("fetched_at") or 0)
    return None, 0.0


def save_api_cache(identity, data):
    try:
        # 0700/0600: this file holds the account's email address and the full
        # usage response. Nothing here is a credential, but it is this user's
        # data and no other account on the Mac needs it.
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        API_CACHE.write_text(json.dumps(
            {"account": identity.label, "email": identity.email, "fetched_at": NOW, "data": data}))
        os.chmod(API_CACHE, 0o600)
        if BACKOFF.exists():
            BACKOFF.unlink()
    except Exception:
        pass


# ── The reading to show ─────────────────────────────────────────────────────

Reading = namedtuple("Reading", "utilization taken_at source fetch_error retry_in")


def current_reading(identity):
    """The freshest utilisation this identity has, from the API when the cache
    is past its TTL and the network path is not parked.

    FRESHEST WINS, whatever its origin: a 5-minute-old API answer beats a
    3-hour-old session cache even when both are past their nominal TTL. The
    first cut ignored the API cache once past TTL and regressed to the older
    file-cache numbers."""
    data, fetched_at = load_api_cache(identity)
    in_backoff, fail_why, retry_in = backoff_state()
    if (data is None or NOW - fetched_at >= API_TTL) and not in_backoff:
        fresh, err = fetch_usage(identity.config_dir)
        if fresh:
            data, fetched_at = fresh, NOW
            fail_why, retry_in = "", 0
            save_api_cache(identity, fresh)
        else:
            wait = BACKOFF_AFTER_429 if err == "429" else BACKOFF_AFTER_OTHER
            start_backoff(wait, err)
            fail_why, retry_in = err, wait
    if data is not None and fetched_at >= identity.cached_at:
        return Reading(data, fetched_at, "api", fail_why, retry_in)
    return Reading(identity.cached_utilization, identity.cached_at, "session-cache", fail_why, retry_in)


def seconds_until_reset(iso, kind=None):
    if not iso:
        return 0
    try:
        resets_at = datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0
    left = resets_at - NOW
    if left < 0:
        cadence = RESET_CADENCE.get(kind or "", 0)
        if cadence <= 0:
            return 0
        left += math.ceil((-left) / cadence) * cadence
    return max(0, int(left))


def limits_and_scoped_label(utilization):
    """The three limits the app draws, plus what the endpoint says the scoped
    weekly cap applies to.

    THE ENDPOINT NAMES THE CAP ITSELF, so nothing here hardcodes a model family
    that will be wrong at the next release. Inspected 2026-09-12: every limits[]
    entry carries `scope`, null on the session and all-models limits and, on
    weekly_scoped, {"model": {"id": null, "display_name": "<name>"},
    "surface": null}. The flat legacy keys beside limits[] (seven_day_opus and
    friends) were null in the same response, so they are not a second source."""
    limits, scoped_label = {}, ""
    for limit in (utilization.get("limits") or []):
        kind = limit.get("kind")
        key = LIMIT_KEYS.get(kind)
        if not key:
            continue
        limits[key] = {
            "pct": int(limit.get("percent") or 0),
            "reset_in": seconds_until_reset(limit.get("resets_at"), kind),
            "severity": limit.get("severity") or "normal",
        }
        if key == "scoped":
            model = (limit.get("scope") or {}).get("model") or {}
            scoped_label = (model.get("display_name") or "").strip()
    # Fall back to the flat structure if limits[] is absent on an older client.
    for key, flat_key, kind in (("session", "five_hour", "session"),
                                ("weekly", "seven_day", "weekly_all")):
        flat = utilization.get(flat_key)
        if key not in limits and isinstance(flat, dict):
            limits[key] = {"pct": int(flat.get("utilization") or 0),
                           "reset_in": seconds_until_reset(flat.get("resets_at"), kind),
                           "severity": "normal"}
    return limits, scoped_label


def append_history(label, limits):
    """Append a point to the usage history the menu graphs."""
    try:
        HISTORY.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        # The label is user-supplied (CLAUDE_METER_CONFIG_DIRS), and this is a
        # five-field CSV parsed by position: a comma in it would shift every
        # later field and the row would be dropped as malformed by the reader --
        # and by the dedupe check here, which rewrites the whole file every poll.
        row = "%d,%s,%d,%d,%d" % (int(NOW), label.replace(",", "-"),
                                  limits.get("session", {}).get("pct", 0),
                                  limits.get("weekly", {}).get("pct", 0),
                                  limits.get("scoped", {}).get("pct", 0))
        rows = HISTORY.read_text().splitlines() if HISTORY.exists() else []
        if rows:
            last = rows[-1].split(",")
            unchanged = len(last) == 5 and last[1:] == row.split(",")[1:]
            if unchanged and int(NOW) - int(last[0]) < HISTORY_MIN_INTERVAL:
                return
        rows.append(row)
        HISTORY.write_text("\n".join(rows[-HISTORY_MAX_ROWS:]) + "\n")
    except Exception:
        pass


# ── codex (the OpenAI Codex CLI) ────────────────────────────────────────────
#
# WHY NOT A FILE. codex persists no quota snapshot this can read. Measured
# 2026-09-20 against codex-cli 0.154.0 signed in with a ChatGPT account: the
# five sqlite databases under $CODEX_HOME hold threads, logs, goals, memories
# and a queue and no rate-limit table between them; `codex doctor` reports
# thirty-odd facts about the install and not one number about usage; and the
# rollout JSONL files that DO carry a `rate_limits` record are written only
# while a session runs, so a Mac that has not run codex today has nothing on
# disk to read at all. Grepping the whole of $CODEX_HOME for a rate-limit
# string found one hit, in an unrelated plugin catalogue.
#
# WHAT IS READ INSTEAD. codex ships its own local JSON-RPC server -- `codex
# app-server`, stdio, the same one its desktop app drives -- and two of its
# methods are exactly this: `account/read` (plan and email, answered from
# $CODEX_HOME alone, 0.03 s, no network) and `account/rateLimits/read` (the
# usage read behind the TUI's `/status` panel, 0.79 s including its round trip).
# Neither is a model request, so neither spends any of the account's quota.
#
# THE CREDENTIAL STAYS CODEX'S. $CODEX_HOME/auth.json holds the account's
# OAuth tokens and NOTHING here opens it: presence is `auth.json` existing, and
# the tokens are used by the app-server, in its own process, as codex already
# does for itself. That is the whole reason this goes through the app-server
# rather than calling `chatgpt.com/backend-api/codex/usage` with a token of our
# own, which would have been the shorter path and the wrong one.

CODEX_HOME = pathlib.Path(os.environ.get("CODEX_HOME") or (HOME / ".codex"))
CODEX_CACHE = CACHE_DIR / "codex-usage.json"
CODEX_BACKOFF = CACHE_DIR / "codex-usage.backoff"

# Where a `codex` binary may be, after PATH. A launchd-spawned shell inherits a
# sparse PATH -- this script seeds /usr/bin and friends into it at the top, and
# that is enough for python3 and curl but not for a CLI installed anywhere
# else -- so PATH alone made an installed codex invisible to the resident
# meter while it was plainly on the developer's own $PATH. Same "first
# executable wins" shape the app uses to find this collector.
CODEX_BIN_DIRS = ("~/.local/bin", "/run/current-system/sw/bin",
                  "/etc/profiles/per-user/%s/bin" % os.environ.get("USER", ""),
                  "~/.nix-profile/bin", "/opt/homebrew/bin", "/usr/local/bin")

CODEX_TTL_WHILE_RUNNING = 120
CODEX_TTL_WHILE_IDLE = 900
CODEX_BACKOFF_SECONDS = 180

# The app-server answers in under a second (measured 0.79 s for the usage read,
# 0.03 s for the account read, 2026-09-20). Ten seconds is a bound on something
# wedged, not a budget: the app's own watchdog has to cover this on top of the
# Claude path's 15 s curl, and both only run once per TTL.
CODEX_CALL_TIMEOUT = 10

CODEX_FETCH_ERROR_TEXT = {"spawn": "codex would not start", "timeout": "codex did not answer",
                          "shape": "bad response", "rpc": "codex refused the request"}


def codex_binary():
    """The codex executable, or None when this Mac has none."""
    found = shutil.which("codex")
    if found:
        return found
    for directory in CODEX_BIN_DIRS:
        candidate = pathlib.Path(os.path.expanduser(directory)) / "codex"
        if os.access(str(candidate), os.X_OK) and candidate.is_file():
            return str(candidate)
    return None


def codex_app_server(binary, calls):
    """Ask a fresh `codex app-server` for each of `calls` ({id: (method, params)})
    and return {id: result}, missing an id whose call failed.

    Spawn-and-kill on purpose: the server is ephemeral unless a daemon is asked
    for, it left no process and wrote no file in the probe this was built from,
    and a meter must not be the thing that starts a resident server nobody asked
    for. Every read is under one deadline, and the child is killed in `finally`
    whatever happens, so a hung server cannot outlive the poll that made it."""
    try:
        server = subprocess.Popen([binary, "app-server"],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True, bufsize=1)
    except Exception:
        return None
    lines, answers = queue.Queue(), {}

    def read_lines():
        try:
            for line in server.stdout:
                lines.put(line)
        except Exception:
            pass
        lines.put(None)

    threading.Thread(target=read_lines, daemon=True).start()
    try:
        # initialize, then the notification that the handshake is done, then
        # every request at once -- the server answers them independently and
        # nothing here depends on their order.
        server.stdin.write(json.dumps({
            "jsonrpc": "2.0", "id": 0, "method": "initialize",
            "params": {"clientInfo": {"name": "claude-meter", "version": "1"}}}) + "\n")
        server.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "initialized", "params": {}}) + "\n")
        for call_id, (method, params) in calls.items():
            server.stdin.write(json.dumps({"jsonrpc": "2.0", "id": call_id,
                                           "method": method, "params": params}) + "\n")
        server.stdin.flush()
        deadline = time.time() + CODEX_CALL_TIMEOUT
        while len(answers) < len(calls):
            left = deadline - time.time()
            if left <= 0:
                break
            try:
                line = lines.get(timeout=left)
            except Exception:
                break
            if line is None:
                break          # the server closed its output
            try:
                message = json.loads(line)
            except Exception:
                continue       # a notification we did not ask for, or a partial line
            call_id = message.get("id")
            if call_id in calls and "result" in message:
                answers[call_id] = message["result"]
            elif call_id in calls:
                answers[call_id] = None    # an error reply: recorded as a miss, not a hang
    except Exception:
        pass
    finally:
        for close in (server.stdin.close, server.kill):
            try:
                close()
            except Exception:
                pass
        try:
            server.wait(timeout=2)
        except Exception:
            pass
    return answers


def codex_is_running():
    try:
        found = subprocess.run(["pgrep", "-f", r"(^|/)codex($| )"],
                               capture_output=True, text=True, timeout=5)
        return found.returncode == 0 and bool(found.stdout.strip())
    except Exception:
        return False


def codex_window_label(minutes):
    """A window's name derived from its own length, because codex does not name
    it. Nothing here hardcodes "5h" or "weekly": the account signed in on this
    Mac reports a 43200-minute (30-day) primary window on a free plan, where a
    paid one reports 300 minutes, and a label this script invented would have
    been wrong for one of them."""
    if not minutes or minutes <= 0:
        return "Limit"
    for size, one, many in ((10080, "Weekly", "%d-week"), (1440, "Daily", "%d-day"),
                            (60, "Hourly", "%dh")):
        if minutes % size == 0:
            count = minutes // size
            return one if count == 1 else many % count
    return "%dm" % minutes


def codex_limits(rate_limits):
    """The windows to draw, in the order codex reports them. `usedPercent` is a
    percentage of the ceiling that actually stops you, the same denominator the
    Claude side uses, so the two sections mean the same thing by "78%".

    codex sends no severity, so the app's own percentage thresholds decide --
    except for the two states the backend states outright, which are worth more
    than any threshold: a limit already reached, and a spend control tripped."""
    reached = bool(rate_limits.get("rateLimitReachedType")) or \
        bool(rate_limits.get("spendControlReached"))
    limits = []
    for key in ("primary", "secondary"):
        window = rate_limits.get(key)
        if not isinstance(window, dict):
            continue
        resets_at = window.get("resetsAt")
        limits.append({
            "label": codex_window_label(window.get("windowDurationMins")),
            "pct": int(window.get("usedPercent") or 0),
            # An epoch-seconds instant here, where the Claude side gets an ISO
            # string; both become seconds-from-now, and a lapsed one becomes 0
            # rather than a negative countdown.
            "reset_in": max(0, int(resets_at - NOW)) if resets_at else 0,
            "severity": "critical" if reached else "normal",
        })
    return limits


def codex_backoff_state():
    try:
        parts = CODEX_BACKOFF.read_text().split()
        stamped_at, wait = float(parts[0]), float(parts[1])
        why = parts[2] if len(parts) > 2 else "error"
        left = stamped_at + wait - time.time()
        return left > 0, why, max(0, int(left))
    except Exception:
        return False, "", 0


def codex_fetch(binary):
    """(reading, errkind). One app-server run answers both questions."""
    answers = codex_app_server(binary, {
        1: ("account/read", {}),
        # excludeResetCreditDetails skips a second backend lookup the app-server
        # would otherwise make; its own schema calls that the shape for
        # "background usage polls", which is exactly what this is.
        2: ("account/rateLimits/read", {"excludeResetCreditDetails": True}),
    })
    if answers is None:
        return None, "spawn"
    usage = answers.get(2)
    if not isinstance(usage, dict):
        return None, "timeout" if 2 not in answers else "rpc"
    rate_limits = usage.get("rateLimits")
    if not isinstance(rate_limits, dict):
        return None, "shape"
    account = (answers.get(1) or {}).get("account") or {}
    return {"email": account.get("email") or "",
            "plan": rate_limits.get("planType") or account.get("planType") or "",
            "rate_limits": rate_limits}, None


def codex_section():
    """The `codex` key of the blob, or None when this Mac has no codex at all."""
    if os.environ.get("CLAUDE_METER_CODEX", "1") == "0":
        return None
    binary = codex_binary()
    if not binary or not CODEX_HOME.is_dir():
        return None                      # not installed: contribute nothing
    if not (CODEX_HOME / "auth.json").exists():
        # Installed but signed out. The section exists -- the tool is here --
        # and says the one thing that would make it work, the same way the app
        # already does for a Claude Code that has never been signed in. The file
        # is checked for EXISTENCE and never opened.
        return {"ok": False, "note": "Not signed in — run `codex login`"}

    cached = load_json(CODEX_CACHE)
    reading, fetched_at = None, 0.0
    if isinstance(cached, dict) and isinstance(cached.get("data"), dict):
        reading, fetched_at = cached["data"], float(cached.get("fetched_at") or 0)
    ttl = int(os.environ.get("CODEX_USAGE_TTL", "0")) or \
        (CODEX_TTL_WHILE_RUNNING if codex_is_running() else CODEX_TTL_WHILE_IDLE)
    in_backoff, fail_why, retry_in = codex_backoff_state()
    if (reading is None or NOW - fetched_at >= ttl) and not in_backoff:
        fresh, err = codex_fetch(binary)
        if fresh:
            reading, fetched_at = fresh, NOW
            fail_why, retry_in = "", 0
            try:
                CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
                CODEX_CACHE.write_text(json.dumps({"fetched_at": NOW, "data": fresh}))
                os.chmod(CODEX_CACHE, 0o600)   # the account's email, nobody else's business
                if CODEX_BACKOFF.exists():
                    CODEX_BACKOFF.unlink()
            except Exception:
                pass
        else:
            try:
                CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
                CODEX_BACKOFF.write_text("%d %d %s" % (time.time(), CODEX_BACKOFF_SECONDS, err))
            except Exception:
                pass
            fail_why, retry_in = err, CODEX_BACKOFF_SECONDS

    out = {"ok": False}
    if fail_why:
        out["fetch_err"] = CODEX_FETCH_ERROR_TEXT.get(fail_why, fail_why)
        out["retry_in"] = retry_in
    if reading is None or fetched_at <= 0:
        # Same contract as the Claude side: a number that cannot be aged is not
        # a number. The section still exists, so the reason is visible.
        out.setdefault("note", "No usage read yet")
        return out
    limits = codex_limits(reading.get("rate_limits") or {})
    if not limits:
        out["note"] = "codex reported no usage window"
        return out
    out["ok"] = True
    out["limits"] = limits
    out["email"] = reading.get("email") or ""
    out["plan"] = reading.get("plan") or ""
    out["source"] = "codex app-server"
    out["age_s"] = max(0, int(NOW - fetched_at))
    return out


def claude_section():
    """The `claude` key of the blob. Always present: this is the Claude Meter,
    and an absent Claude Code is the app's own empty state, not a missing
    section."""
    identity = pick_identity()
    if identity is None:
        return {"ok": False}
    reading = current_reading(identity)
    limits, scoped_label = limits_and_scoped_label(reading.utilization)

    # NOTHING TO SHOW IS NOT "ok". An identity can be known by its email alone
    # -- a fresh /login whose cachedUsageUtilization has not been written yet --
    # and with the live path down that leaves no limits and no timestamp to age
    # them by. Emitted as ok:true (measured 2026-09-12) that produced
    # {"ok": true, "source": "session-cache", "age_s": 1789211658} -- the raw
    # epoch, because the age is computed against a taken_at of 0 -- and the app,
    # which gates only on ok, painted three grey 0% bars as if they were real.
    # A missing timestamp is disqualifying on its own: this meter's contract is
    # that every number carries its age, so a reading that cannot be aged is
    # not a reading. ok:false selects the app's own empty state, a dash.
    if reading.taken_at <= 0 or not limits:
        return {"ok": False}

    out = dict(limits)
    out["ok"] = True
    out["account"] = identity.label
    out["email"] = identity.email
    out["scoped_label"] = scoped_label or DEFAULT_SCOPED_LABEL
    out["source"] = reading.source
    out["age_s"] = max(0, int(NOW - reading.taken_at))
    out["stale_hours"] = max(0.0, round((NOW - reading.taken_at) / 3600, 1))
    if reading.fetch_error:
        out["fetch_err"] = FETCH_ERROR_TEXT.get(reading.fetch_error, reading.fetch_error)
        out["retry_in"] = reading.retry_in
    append_history(identity.label, limits)
    return out


def main():
    # `claude` is always emitted; every other tool contributes a key ONLY when
    # it is installed, so the blob a Mac with neither produces is byte-identical
    # to the one this script produced before either was supported. A section
    # that raises is dropped rather than taking the whole blob down with it --
    # the Claude reading is what this app exists for and must survive a second
    # tool misbehaving.
    blob = {"claude": claude_section(), "ts": int(NOW)}
    for key, build in (("codex", codex_section),):
        try:
            section = build()
        except Exception:
            section = None
        if section is not None:
            blob[key] = section
    print(json.dumps(blob))


main()
PY
meter_json="$(cat "$py_out")"
rm -f "$py_out"

# The Python program prints the whole blob, "ts" included. An empty file means
# it never got to print -- killed by the app's watchdog, or dead on a syntax
# error -- and the app needs the shape it knows how to show as "no reading"
# rather than nothing at all.
[ -n "$meter_json" ] || meter_json="$(printf '{"claude":{"ok":false},"ts":%s}' "$(date +%s)")"
printf '%s\n' "$meter_json"
